#!/bin/sh
set -e
REPO_ROOT=$(git rev-parse --show-toplevel)
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

files_changed() {
  echo "$STAGED" | grep -q "$1"
}

CHECKS=""

if files_changed '^docs/'; then
  CHECKS="$CHECKS echo 'running markdownlint...' >&2 &&"
  CHECKS="$CHECKS npx markdownlint 'docs/**/*.md' &&"
  CHECKS="$CHECKS echo 'running jeykyll build...' >&2 &&"
  CHECKS="$CHECKS bundle exec jekyll build --source docs/ --destination ../_site --config docs/ghp/_config.yml &&"
fi

CHECKS=$(echo "$CHECKS" | sed 's/ &&$//')

if [ -n "$CHECKS" ]; then
  echo "Running checks..."
  docker compose -f "$REPO_ROOT/docker/docker-compose-pre-commit.yml" \
    run --rm checks sh -c "$CHECKS" > /dev/null 2>&1
fi

echo "✅ All checks passed!"
