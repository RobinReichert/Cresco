# Build output
build/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Local Jekyll/Ruby lock files
docs/config/Gemfile.lock

# Jekyll/Sass cache files
docs/.jekyll-cache
docs/.sass-cache

# Files created by mac_os
.DS_STORE
