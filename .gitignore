build/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Local Jekyll/Ruby lock files
docs/config/Gemfile.lock

# Cache files
docs/.jekyll-cache
docs/.sass-cache
cross/.pre-build-cache.json

# Jekyll incremental build metadata
docs/.jekyll-metadata

# drawio diagrams are build in ci
docs/assets/drawio

# Files created by mac_os
.DS_STORE

# Python environment
.venv/
